<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.XDevPocket" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#05070A</item>
        <item name="android:navigationBarColor">#05070A</item>
        <item name="android:windowBackground">#05070A</item>
    </style>

    <style name="Theme.XDevPocket.Splash" parent="Theme.SplashScreen">
