<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.XDevPocket" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#05070A</item>
        <item name="android:navigationBarColor">#05070A</item>
        <item name="android:windowBackground">#05070A</item>
    </style>

    <!--
      System splash screen (androidx.core.splashscreen). Kept intentionally minimal —
      just the brand mark on the app's dark background — because the SplashScreen
      API masks the icon into a circle/square and isn't meant for a full wordmark
      logo. The full x-DevPocket banner is shown right after on our own Compose
      splash screen (see presentation/screens/splash), which has no such constraint.
    -->
    <style name="Theme.XDevPocket.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#05070A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.XDevPocket</item>
    </style>
</resources>

